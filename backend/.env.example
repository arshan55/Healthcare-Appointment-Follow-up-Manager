# Environment variables — copy to backend/.env
# Never commit real secrets.

# PostgreSQL connection (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare

# JWT signing secret (required in production)
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRY=30d

PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Redis for BullMQ. If empty, jobs run in-process with the same retry logic.
REDIS_URL=redis://localhost:6379

# Slot hold length before confirmation
SLOT_HOLD_MINUTES=10

# LLM (Google Gemini). Get a free key at https://aistudio.google.com/app/apikey
# Leave empty to use the built-in mock (structured JSON, no network).
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash

# SMTP. Leave host empty to log emails to the console + email_logs table.
# For production, use SendGrid (recommended) - Gmail SMTP is blocked on most cloud providers.
SENDGRID_API_KEY=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM_ADDRESS=noreply@healthcare.local

# Google Calendar OAuth. Leave client id empty to skip calendar writes (booking still succeeds).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:4000/api/v1/calendar/callback
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/calendar/callback

# Google OAuth for login. Falls back to Calendar OAuth credentials if not set.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
